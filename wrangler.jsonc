{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comparativeai",
  "compatibility_date": "2026-04-22",
  "observability": {
    "enabled": true
  },
  // Pure static deployment — no Worker code, just assets.
  // Astro builds plain HTML/CSS/JS into dist/; CF Workers Static Assets
  // serves them directly. No 3 MiB Worker size limit applies.
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  }
}
