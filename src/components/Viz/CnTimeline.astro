---
// Viz A — Horizontal interactive timeline of China's AI regulation evolution.
// Scroll horizontally; click a node to expand inline detail card.
import { cnTimeline } from '../../data/viz-data';

export interface Props {
	locale?: 'zh-CN' | 'en';
}
const { locale = 'zh-CN' } = Astro.props;
const k = locale === 'en' ? 'en' : 'zh';
const basePath = locale === 'zh-CN' ? '/zh' : '';

// Sort by date ascending
const events = [...cnTimeline].sort((a, b) => a.date.localeCompare(b.date));

// Span years for axis ticks
const years = [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];

// Precompute X positions based on date within axis (months since 2017-01)
const months = (d: string) => {
	const [y, m] = d.split('-').map(Number);
	return (y - 2017) * 12 + m;
};
const minMonths = months('2017-01');
const maxMonths = months('2027-01');
const range = maxMonths - minMonths;
const pct = (d: string) => (100 * (months(d) - minMonths)) / range;

// Tier-based accent colors
const tierColors = {
	1: '#8b2e2e', // 法律
	2: '#9a4a3b', // 行政法规
	3: '#a66a4e', // 部门规章
	4: '#73845a', // 规范性文件
	5: '#5a7a6b', // 技术标准
};
const tierLabels = {
	1: { zh: '法律', en: 'Law' },
	2: { zh: '行政法规', en: 'Admin Reg.' },
	3: { zh: '部门规章', en: 'Dept. Rule' },
	4: { zh: '规范性文件', en: 'Normative Doc' },
	5: { zh: '技术标准', en: 'Tech Standard' },
} as const;

const topicLabels = {
	risk: { zh: '风险', en: 'Risk' },
	gpai: { zh: 'GPAI', en: 'GPAI' },
	data: { zh: '数据', en: 'Data' },
	labeling: { zh: '标识', en: 'Labeling' },
	minors: { zh: '未成年', en: 'Minors' },
	ethics: { zh: '伦理', en: 'Ethics' },
	strategy: { zh: '战略', en: 'Strategy' },
} as const;

const headings = {
	title: { zh: '中国 AI 监管演进·时间线', en: "China's AI Regulation · Evolution Timeline" },
	sub: {
		zh: '横向拖拽或滚动查看；点击任一节点展开摘要。颜色标示法律位阶。',
		en: 'Drag or scroll horizontally; click any node to reveal its summary. Colors encode legal tier.',
	},
	legendTiers: { zh: '位阶', en: 'Tiers' },
	legendTopics: { zh: '议题', en: 'Topics' },
};

// For stagger (avoid overlap), alternate y offset for adjacent events
const positioned = events.map((e, i) => ({
	...e,
	x: pct(e.date),
	y: i % 2 === 0 ? 'above' : 'below',
	href: basePath + e.href,
}));
---

<section class="viz-timeline" data-locale={locale}>
	<header class="tl-head">
		<h2 class="viz-title">{headings.title[k]}</h2>
		<p class="viz-sub">{headings.sub[k]}</p>
		<div class="tl-legend">
			<div class="legend-group">
				<span class="legend-label">{headings.legendTiers[k]}:</span>
				{Object.entries(tierLabels).map(([lvl, lab]) => (
					<span class="legend-chip" style={`--c:${tierColors[Number(lvl) as 1|2|3|4|5]}`}>
						<span class="chip-dot"></span>{lab[k]}
					</span>
				))}
			</div>
		</div>
	</header>

	<div class="tl-scroll" role="region" aria-label={headings.title[k]} tabindex="0">
		<div class="tl-inner">
			<!-- axis line -->
			<div class="tl-axis">
				{years.map((y) => (
					<span class="axis-tick" style={`left:${pct(`${y}-01`)}%`}>
						<span class="tick-mark"></span>
						<span class="tick-year">{y}</span>
					</span>
				))}
			</div>

			<!-- events -->
			{
				positioned.map((e) => (
					<button
						type="button"
						class={`tl-node tl-${e.y}`}
						style={`left:${e.x}%; --c:${tierColors[e.tier]}`}
						data-node={e.id}
						aria-expanded="false"
						aria-controls={`tl-detail-${e.id}`}
					>
						<span class="node-dot"></span>
						<span class="node-line"></span>
						<span class="node-card">
							<span class="node-date">{e.date}</span>
							<span class="node-title">{e.title[k]}</span>
							<span class="node-tier">{tierLabels[e.tier][k]}</span>
						</span>
					</button>
				))
			}
		</div>
	</div>

	<!-- Detail panel: shown when a node is clicked -->
	<div class="tl-detail-wrap">
		<div class="tl-detail-empty">
			{locale === 'en' ? 'Click any node above for summary.' : '点击上方任一节点查看摘要。'}
		</div>
		{
			positioned.map((e) => (
				<article class="tl-detail" id={`tl-detail-${e.id}`} data-detail={e.id} hidden>
					<header class="det-head" style={`border-color:${tierColors[e.tier]}`}>
						<span class="det-tier" style={`background:${tierColors[e.tier]}`}>
							{tierLabels[e.tier][k]}
						</span>
						<h3 class="det-title">{e.title[k]}</h3>
						<span class="det-date">{e.date}</span>
					</header>
					<p class="det-kind">{e.kind[k]}</p>
					<p class="det-summary">{e.summary[k]}</p>
					<div class="det-topics">
						{e.topics.map((t) => (
							<span class="topic-tag">{topicLabels[t][k]}</span>
						))}
					</div>
					<a class="det-link" href={e.href}>
						{locale === 'en' ? 'Open rule page →' : '查看规则详情 →'}
					</a>
				</article>
			))
		}
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.viz-timeline').forEach((root) => {
		const nodes = root.querySelectorAll<HTMLButtonElement>('.tl-node');
		const details = root.querySelectorAll<HTMLElement>('.tl-detail');
		const empty = root.querySelector<HTMLElement>('.tl-detail-empty');
		const show = (id: string) => {
			if (empty) empty.hidden = true;
			details.forEach((d) => {
				d.hidden = d.dataset.detail !== id;
			});
			nodes.forEach((n) => {
				const active = n.dataset.node === id;
				n.setAttribute('aria-expanded', String(active));
				n.classList.toggle('active', active);
			});
		};
		nodes.forEach((n) => {
			n.addEventListener('click', () => show(n.dataset.node!));
		});
	});
</script>

<style>
	.viz-timeline {
		--ink: #1c1a17;
		--ink-soft: #45423d;
		--ink-muted: #726d65;
		--paper: #fdfcfa;
		--paper-alt: #f4f2ed;
		--rule: #dcd7cc;
		font-family: 'Noto Serif SC', 'Source Serif 4', Georgia, serif;
		color: var(--ink);
		max-width: 1200px;
		margin: 32px auto 48px;
	}
	.viz-title {
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.005em;
		margin-bottom: 8px;
	}
	.viz-sub {
		font-family: 'Source Serif 4', Georgia, serif;
		font-style: italic;
		font-size: 15px;
		color: var(--ink-muted);
		margin-bottom: 18px;
		max-width: 64ch;
	}
	.tl-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin-bottom: 16px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--rule);
	}
	.legend-group {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}
	.legend-label {
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.legend-chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 12.5px;
		color: var(--ink-soft);
	}
	.chip-dot {
		width: 8px;
		height: 8px;
		background: var(--c);
		display: inline-block;
	}

	.tl-scroll {
		overflow-x: auto;
		overflow-y: hidden;
		border: 1px solid var(--rule);
		background:
			linear-gradient(90deg, var(--paper-alt) 0, transparent 4px),
			linear-gradient(-90deg, var(--paper-alt) 0, transparent 4px),
			var(--paper);
		scroll-snap-type: x proximity;
	}
	.tl-inner {
		position: relative;
		width: 2200px;
		height: 420px;
	}

	.tl-axis {
		position: absolute;
		top: 210px;
		left: 0;
		right: 0;
		height: 40px;
	}
	.tl-axis::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--ink);
	}
	.axis-tick {
		position: absolute;
		top: 0;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
	}
	.tick-mark {
		display: block;
		width: 1px;
		height: 8px;
		background: var(--ink-muted);
	}
	.tick-year {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: var(--ink-muted);
	}

	.tl-node {
		position: absolute;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 160px;
		scroll-snap-align: center;
	}
	.tl-node.tl-above {
		top: 30px;
		flex-direction: column;
	}
	.tl-node.tl-below {
		top: 240px;
		flex-direction: column-reverse;
	}
	.node-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--c);
		border: 2px solid var(--paper);
		box-shadow: 0 0 0 1px var(--c);
		flex-shrink: 0;
		z-index: 2;
	}
	.node-line {
		width: 1px;
		height: 40px;
		background: var(--c);
		opacity: 0.55;
	}
	.node-card {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 8px 10px;
		background: var(--paper);
		border: 1px solid var(--rule);
		border-left: 3px solid var(--c);
		max-width: 150px;
		transition: all 0.15s;
	}
	.tl-node:hover .node-card,
	.tl-node.active .node-card {
		background: var(--paper-alt);
		border-color: var(--c);
	}
	.node-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 10.5px;
		color: var(--ink-muted);
	}
	.node-title {
		font-family: 'Noto Serif SC', serif;
		font-size: 13px;
		line-height: 1.35;
		color: var(--ink);
		font-weight: 500;
	}
	.node-tier {
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 10.5px;
		color: var(--c);
		letter-spacing: 0.05em;
	}

	.tl-detail-wrap {
		margin-top: 20px;
		min-height: 180px;
	}
	.tl-detail-empty {
		font-family: 'Source Serif 4', serif;
		font-style: italic;
		color: var(--ink-muted);
		text-align: center;
		padding: 32px;
	}
	.tl-detail {
		background: var(--paper-alt);
		padding: 20px 24px;
	}
	.det-head {
		display: flex;
		align-items: baseline;
		gap: 14px;
		border-bottom: 2px solid var(--rule);
		padding-bottom: 10px;
		margin-bottom: 12px;
	}
	.det-tier {
		font-family: 'JetBrains Mono', monospace;
		font-size: 11px;
		color: var(--paper);
		padding: 2px 8px;
		letter-spacing: 0.05em;
	}
	.det-title {
		flex: 1;
		font-size: 18px;
		font-weight: 600;
	}
	.det-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12.5px;
		color: var(--ink-muted);
	}
	.det-kind {
		font-family: 'Source Serif 4', serif;
		font-style: italic;
		font-size: 14px;
		color: var(--ink-muted);
		margin-bottom: 8px;
	}
	.det-summary {
		font-size: 15.5px;
		color: var(--ink-soft);
		line-height: 1.7;
		margin-bottom: 12px;
	}
	.det-topics {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}
	.topic-tag {
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 11.5px;
		padding: 2px 10px;
		border: 1px solid var(--ink-muted);
		color: var(--ink-soft);
		letter-spacing: 0.04em;
	}
	.det-link {
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 13px;
		color: var(--ink);
		border-bottom: 1px solid var(--ink-muted);
		text-decoration: none;
		padding-bottom: 1px;
	}
	.det-link:hover {
		border-bottom-color: var(--ink);
	}

	@media (max-width: 720px) {
		.tl-inner {
			width: 1600px;
			height: 380px;
		}
		.node-card {
			max-width: 120px;
		}
		.node-title {
			font-size: 12px;
		}
	}
</style>
