---
// Viz E — China 5-tier legal hierarchy (vertical tree with expandable rule lists)
import { cnHierarchy } from '../../data/viz-data';

export interface Props {
	locale?: 'zh-CN' | 'en';
}
const { locale = 'zh-CN' } = Astro.props;
const k = locale === 'en' ? 'en' : 'zh';
const basePath = locale === 'en' ? '/en' : '';

// Localized rule hrefs
const tiers = cnHierarchy.map((t) => ({
	...t,
	rules: t.rules.map((r) => ({ ...r, href: basePath + r.href })),
}));

const headings = {
	title: { zh: '中国 AI 治理·五级法律位阶', en: "China's AI Governance · Five-Tier Legal Hierarchy" },
	sub: {
		zh: '点击某一级查看所属规则；位阶**越高**（数字越小）→ **法律效力越强**。',
		en: 'Click a tier to expand its rules. Higher tier (smaller number) = greater legal force.',
	},
	issuer: { zh: '制定机关', en: 'Issuer' },
	form: { zh: '典型形式', en: 'Typical form' },
};

// Tier accent colors (intensity decreases toward standards layer)
const colors = ['#8b2e2e', '#9a4a3b', '#a66a4e', '#73845a', '#5a7a6b'];
---

<section class="viz-hierarchy" data-locale={locale}>
	<h2 class="viz-title">{headings.title[k]}</h2>
	<p class="viz-sub" set:html={headings.sub[k].replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}></p>

	<div class="hier-wrap">
		{
			tiers.map((t, i) => (
				<div class="tier-row" data-tier={t.level} style={`--accent:${colors[i]}`}>
					<div class="tier-head">
						<div class="tier-num">
							<span class="num-circle">{t.level}</span>
							<span class="num-conn" />
						</div>
						<div class="tier-labels">
							<h3 class="tier-label">{t.label[k]}</h3>
							<div class="tier-meta">
								<span>
									<em>{headings.issuer[k]}</em> {t.issuer[k]}
								</span>
								<span>
									<em>{headings.form[k]}</em> <code>{t.form[k]}</code>
								</span>
							</div>
						</div>
						<button
							type="button"
							class="tier-toggle"
							aria-expanded="false"
							aria-controls={`tier-${t.level}-rules`}
						>
							<span class="count">{t.rules.length}</span>
							<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
								<path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" />
							</svg>
						</button>
					</div>
					<ul id={`tier-${t.level}-rules`} class="tier-rules" hidden>
						{t.rules.map((r) => (
							<li>
								<a href={r.href}>
									<span class="rule-title">{r.title[k]}</span>
									<span class="rule-year">{r.year}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('.viz-hierarchy .tier-toggle').forEach((btn) => {
		btn.addEventListener('click', () => {
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!expanded));
			const row = btn.closest('.tier-row');
			const list = row?.querySelector<HTMLElement>('.tier-rules');
			if (list) list.hidden = expanded;
		});
	});
</script>

<style>
	.viz-hierarchy {
		--ink: #1c1a17;
		--ink-soft: #45423d;
		--ink-muted: #726d65;
		--paper: #fdfcfa;
		--paper-alt: #f4f2ed;
		--rule: #dcd7cc;
		font-family: 'Noto Serif SC', 'Source Serif 4', Georgia, serif;
		color: var(--ink);
		max-width: 1100px;
		margin: 32px auto 48px;
	}
	.viz-title {
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.005em;
		margin-bottom: 8px;
	}
	.viz-sub {
		font-family: 'Source Serif 4', Georgia, serif;
		font-style: italic;
		font-size: 15px;
		color: var(--ink-muted);
		margin-bottom: 24px;
		max-width: 64ch;
	}
	.viz-sub strong {
		font-style: normal;
		color: var(--ink);
		font-weight: 600;
	}
	.hier-wrap {
		display: flex;
		flex-direction: column;
	}
	.tier-row {
		border-left: 2px solid var(--accent);
		padding-left: 28px;
		padding-bottom: 16px;
		position: relative;
	}
	.tier-row:last-child {
		padding-bottom: 0;
	}
	.tier-head {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 20px;
		align-items: center;
		padding: 16px 0;
	}
	.tier-num {
		position: absolute;
		left: -18px;
		top: 16px;
	}
	.num-circle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: 2px solid var(--accent);
		background: var(--paper);
		border-radius: 50%;
		font-family: 'JetBrains Mono', monospace;
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
	}
	.tier-label {
		font-size: 19px;
		font-weight: 600;
		margin-bottom: 4px;
		color: var(--accent);
	}
	.tier-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 20px;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: 13.5px;
		color: var(--ink-muted);
	}
	.tier-meta em {
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 10.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-right: 6px;
		font-style: normal;
	}
	.tier-meta code {
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: var(--ink);
	}
	.tier-toggle {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: transparent;
		border: 1px solid var(--rule);
		padding: 6px 12px;
		cursor: pointer;
		font-family: 'JetBrains Mono', monospace;
		font-size: 12px;
		color: var(--ink-soft);
		transition: all 0.15s;
	}
	.tier-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.tier-toggle .count {
		font-weight: 600;
	}
	.tier-toggle[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}
	.tier-rules {
		list-style: none;
		padding: 0 0 12px 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
		background: var(--rule);
		border: 1px solid var(--rule);
	}
	.tier-rules li {
		background: var(--paper);
	}
	.tier-rules a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 12px 16px;
		color: var(--ink);
		text-decoration: none;
		gap: 12px;
		transition: background 0.15s;
	}
	.tier-rules a:hover {
		background: var(--paper-alt);
	}
	.rule-title {
		font-family: 'Noto Serif SC', serif;
		font-size: 14.5px;
		line-height: 1.4;
	}
	.rule-year {
		font-family: 'JetBrains Mono', monospace;
		font-size: 11.5px;
		color: var(--ink-muted);
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		.tier-head {
			grid-template-columns: 1fr auto;
		}
		.tier-num {
			display: none;
		}
		.tier-row {
			border-left: 3px solid var(--accent);
			padding-left: 16px;
		}
		.tier-rules {
			grid-template-columns: 1fr;
		}
	}
</style>
