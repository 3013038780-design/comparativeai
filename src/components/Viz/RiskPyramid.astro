---
// Viz D — EU AI Act risk pyramid (4 tiers, pure SVG, interactive tooltip)
import { euPyramid } from '../../data/viz-data';

export interface Props {
	locale?: 'zh-CN' | 'en';
}
const { locale = 'zh-CN' } = Astro.props;
const k = locale === 'en' ? 'en' : 'zh';

// Pyramid geometry: trapezoids stacked bottom-up (wide base, narrow apex)
const W = 760;
const H = 520;
const cx = W / 2;
// Each tier height
const tierH = 100;
const gap = 4;
// Tier widths: top (level 1) narrow, bottom (level 4) wide
const widths = { 1: 160, 2: 340, 3: 520, 4: 720 };
// Fill colors: high-risk warm, cooler toward base
const colors = {
	1: '#8b2e2e', // 禁止 · 朱砂
	2: '#b85c2e', // 高风险 · 橘红
	3: '#6b6a3f', // 有限 · 卡其
	4: '#6b7a3f', // 最低 · 墨绿
};
// Start Y from top
const startY = 40;
// Precompute tier geometries
const tiers = euPyramid.map((t, i) => {
	const yTop = startY + i * (tierH + gap);
	const yBot = yTop + tierH;
	const wTop = widths[t.level];
	const wBot = widths[(t.level + 1) as 2 | 3 | 4] ?? wTop + 80; // fallback, but base already largest
	const topLeft = [cx - wTop / 2, yTop];
	const topRight = [cx + wTop / 2, yTop];
	const botRight = [cx + wBot / 2, yBot];
	const botLeft = [cx - wBot / 2, yBot];
	return {
		...t,
		points: `${topLeft.join(',')} ${topRight.join(',')} ${botRight.join(',')} ${botLeft.join(',')}`,
		fill: colors[t.level],
		labelX: cx,
		labelY: yTop + tierH / 2,
	};
});

const headings = {
	title: { zh: 'EU AI Act 四级风险金字塔', en: 'EU AI Act · Four-Tier Risk Pyramid' },
	sub: {
		zh: '鼠标悬停 / 点击每级查看定义、条款出处、示例与适用时间。',
		en: 'Hover or tap each tier for definition, article references, examples, and application date.',
	},
	articles: { zh: '条款', en: 'Articles' },
	since: { zh: '生效', en: 'Applicable since' },
	examples: { zh: '示例', en: 'Examples' },
	close: { zh: '关闭', en: 'Close' },
};
---

<section class="viz-pyramid" data-locale={locale}>
	<h2 class="viz-title">{headings.title[k]}</h2>
	<p class="viz-sub">{headings.sub[k]}</p>

	<div class="viz-pyramid-wrap">
		<svg
			viewBox={`0 0 ${W} ${H}`}
			class="pyramid-svg"
			role="img"
			aria-label={headings.title[k]}
		>
			{
				tiers.map((t) => (
					<g
						class="tier"
						data-tier={t.id}
						tabindex="0"
						role="button"
						aria-label={t.label[k]}
					>
						<polygon points={t.points} fill={t.fill} stroke="#1c1a17" stroke-width="1" />
						<text
							x={t.labelX}
							y={t.labelY - 6}
							text-anchor="middle"
							class="tier-label-zh"
						>
							{t.label.zh.split(' · ')[0]}
						</text>
						<text
							x={t.labelX}
							y={t.labelY + 16}
							text-anchor="middle"
							class="tier-label-en"
						>
							{t.label.en}
						</text>
					</g>
				))
			}
		</svg>

		<aside class="pyramid-detail" aria-live="polite">
			<div class="detail-empty">
				{locale === 'en' ? 'Click a tier for details.' : '点击任一级查看详情。'}
			</div>
			{
				tiers.map((t) => (
					<div class="detail-card" data-card={t.id} hidden>
						<header>
							<span class={`marker marker-${t.level}`} style={`background:${t.fill}`} />
							<h3>{t.label[k]}</h3>
						</header>
						<p class="def">{t.definition[k]}</p>
						<dl>
							<dt>{headings.articles[k]}</dt>
							<dd>
								<code>{t.articles}</code>
							</dd>
							<dt>{headings.since[k]}</dt>
							<dd>
								<code>{t.appliedSince}</code>
							</dd>
							<dt>{headings.examples[k]}</dt>
							<dd>{t.examples[k]}</dd>
						</dl>
					</div>
				))
			}
		</aside>
	</div>
</section>

<script>
	// Interactive: click tier → show matching detail card.
	document.querySelectorAll<HTMLElement>('.viz-pyramid').forEach((root) => {
		const cards = root.querySelectorAll<HTMLElement>('.detail-card');
		const empty = root.querySelector<HTMLElement>('.detail-empty');
		const tiers = root.querySelectorAll<SVGGElement>('g.tier');
		const show = (id: string) => {
			if (empty) empty.hidden = true;
			cards.forEach((c) => {
				c.hidden = c.dataset.card !== id;
			});
			tiers.forEach((g) => {
				g.classList.toggle('active', g.dataset.tier === id);
			});
		};
		tiers.forEach((g) => {
			g.addEventListener('click', () => show(g.dataset.tier!));
			g.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					show(g.dataset.tier!);
				}
			});
		});
	});
</script>

<style>
	.viz-pyramid {
		--ink: #1c1a17;
		--ink-soft: #45423d;
		--ink-muted: #726d65;
		--paper: #fdfcfa;
		--paper-alt: #f4f2ed;
		--rule: #dcd7cc;
		font-family: 'Noto Serif SC', 'Source Serif 4', Georgia, serif;
		color: var(--ink);
		max-width: 1100px;
		margin: 32px auto 48px;
	}
	.viz-title {
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.005em;
		margin-bottom: 8px;
	}
	.viz-sub {
		font-family: 'Source Serif 4', Georgia, serif;
		font-style: italic;
		font-size: 15px;
		color: var(--ink-muted);
		margin-bottom: 24px;
		max-width: 64ch;
	}
	.viz-pyramid-wrap {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 40px;
		align-items: start;
	}
	.pyramid-svg {
		width: 100%;
		height: auto;
		display: block;
	}
	g.tier {
		cursor: pointer;
		transition: opacity 0.15s;
	}
	g.tier:hover,
	g.tier:focus-visible,
	g.tier.active {
		opacity: 0.88;
	}
	g.tier polygon {
		transition: filter 0.15s;
	}
	g.tier.active polygon {
		filter: drop-shadow(0 0 6px rgba(28, 26, 23, 0.3));
	}
	.tier-label-zh {
		font-family: 'Noto Serif SC', serif;
		font-size: 15px;
		font-weight: 600;
		fill: #fdfcfa;
		pointer-events: none;
	}
	.tier-label-en {
		font-family: 'Source Serif 4', serif;
		font-style: italic;
		font-size: 12px;
		fill: rgba(253, 252, 250, 0.85);
		pointer-events: none;
	}

	.pyramid-detail {
		border-left: 1px solid var(--rule);
		padding-left: 28px;
		min-height: 300px;
	}
	.detail-empty {
		font-family: 'Source Serif 4', serif;
		font-style: italic;
		color: var(--ink-muted);
		padding-top: 48px;
		text-align: center;
	}
	.detail-card header {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 14px;
	}
	.detail-card .marker {
		display: inline-block;
		width: 12px;
		height: 12px;
		border: 1px solid var(--ink);
	}
	.detail-card h3 {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.005em;
	}
	.detail-card .def {
		font-family: 'Source Serif 4', serif;
		font-size: 15px;
		color: var(--ink-soft);
		line-height: 1.7;
		margin-bottom: 18px;
	}
	.detail-card dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 8px 16px;
		font-size: 14px;
	}
	.detail-card dt {
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-muted);
		padding-top: 2px;
	}
	.detail-card dd {
		color: var(--ink);
		line-height: 1.6;
	}
	.detail-card code {
		font-family: 'JetBrains Mono', Menlo, monospace;
		font-size: 13px;
		background: var(--paper-alt);
		padding: 1px 6px;
	}

	@media (max-width: 820px) {
		.viz-pyramid-wrap {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.pyramid-detail {
			border-left: none;
			border-top: 1px solid var(--rule);
			padding-left: 0;
			padding-top: 20px;
			min-height: auto;
		}
	}
</style>
